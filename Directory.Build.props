<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Version>2.0.1</Version>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <StageRoot Condition="'$(StageRoot)' == ''">$(MSBuildThisFileDirectory)out\Framework\$(Configuration)</StageRoot>
    <BaseIntermediateOutputPath Condition="'$(MSBuildProjectName)' == 'Gkms.ExamplePlugin'">obj\example\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
