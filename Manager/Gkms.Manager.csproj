<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\Host\Gkms.Host.csproj" /></ItemGroup>
  <Target Name="StageManager" AfterTargets="Build">
    <ItemGroup><ManagerFile Include="$(TargetPath);$(TargetDir)Gkms.Manager.exe;$(TargetDir)Gkms.Manager.deps.json;$(TargetDir)Gkms.Manager.runtimeconfig.json;$(TargetDir)Gkms.Host.dll;$(TargetDir)Gkms.Sdk.dll;$(TargetDir)ImGui.NET.dll" /></ItemGroup>
    <Copy SourceFiles="@(ManagerFile)" DestinationFolder="$(StageRoot)\gakumas-local\re" />
    <PropertyGroup><Stage>$(StageRoot)\gakumas-local\re</Stage></PropertyGroup>
    <ItemGroup>
      <FormerPlugin Include="Gkms.TextureCapture;Gkms.SettingsPanel;Gkms.UnityLog" />
      <FormerTool Include="Gkms.Resources.exe;Gkms.Resources.dll;Gkms.Resources.deps.json;Gkms.Resources.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(FormerTool->'$(Stage)\%(Identity)');@(FormerPlugin->'$(Stage)\plugins\%(Identity)\plugin.json');@(FormerPlugin->'$(Stage)\plugins\%(Identity)\%(Identity).dll')" />
  </Target>
</Project>
