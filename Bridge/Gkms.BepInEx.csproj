<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Host\Gkms.Host.csproj" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.793" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="StageBridge" AfterTargets="Build">
    <ItemGroup>
      <BridgeFile Include="$(TargetPath);$(TargetDir)Gkms.Host.dll;$(TargetDir)Gkms.Sdk.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeFile)" DestinationFolder="$(MSBuildThisFileDirectory)..\out\$(Configuration)\BepInEx\plugins\GkmsLocalify" />
  </Target>
</Project>
